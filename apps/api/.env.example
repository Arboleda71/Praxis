# Copia este archivo como .env (nunca subas .env al repositorio).
DATABASE_URL=postgresql://praxis:praxis@localhost:5432/praxis
PORT=3001
# URL pública de la web, para los enlaces de los correos.
WEB_URL=http://localhost:3000
# Sin clave, los correos se guardan como archivos en apps/api/.correos/ (desarrollo y pruebas).
RESEND_API_KEY=
CORREO_REMITENTE=Praxis <no-responder@praxis.local>
# Archivos del perfil (M3). Sin S3_BUCKET se guardan en ARCHIVOS_DIR (por defecto apps/api/.archivos/).
# ARCHIVOS_SECRETO firma los enlaces temporales del backend en disco. En producción S3_BUCKET es obligatorio.
ARCHIVOS_SECRETO=
ARCHIVOS_DIR=
# Producción: bucket privado compatible con S3 (Cloudflare R2 o AWS S3).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
