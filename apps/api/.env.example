# Copia este archivo como .env (nunca subas .env al repositorio).
DATABASE_URL=postgresql://praxis:praxis@localhost:5432/praxis
PORT=3001
# URL pública de la web, para los enlaces de los correos.
WEB_URL=http://localhost:3000
# Sin clave, los correos se guardan como archivos en apps/api/.correos/ (desarrollo y pruebas).
RESEND_API_KEY=
CORREO_REMITENTE=Praxis <no-responder@praxis.local>
# Archivos del perfil (M3). Sin S3_BUCKET se guardan en ARCHIVOS_DIR (por defecto apps/api/.archivos/).
# ARCHIVOS_SECRETO firma los enlaces temporales del backend en disco. En producción S3_BUCKET es obligatorio.
ARCHIVOS_SECRETO=
ARCHIVOS_DIR=
# Producción: bucket privado compatible con S3 (Cloudflare R2 o AWS S3).
S3_BUCKET=
# S3_ENDPOINT: solo para R2 u otro compatible (https://<cuenta>.r2.cloudflarestorage.com); vacío en AWS.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Secreto compartido con la web (misma variable en Vercel): con él la API cree la IP del visitante que
# le declara la web. Obligatorio en producción, 32 caracteres o más. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SECRETO=

# Pagos del piloto: solo sandbox. Obtén las tres llaves en tu comercio de pruebas.
# Sin ellas, la interfaz muestra pagos no conectados y no activa planes.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Configura el webhook de pruebas en una URL pública HTTPS que termine en /pagos/eventos.
# ARCHIVOS_SECRETO es obligatorio en almacenamiento local; usa un valor aleatorio fuera del repositorio.
# Los comandos demo:db y demo:api fijan la base aislada y evitan todas las conexiones externas.
