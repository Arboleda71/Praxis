generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ESTUDIANTE
  EMPRESA
}

/// Credenciales y estado de la cuenta. Los datos de cada rol viven aparte (anonimizar sin rehacer el modelo).
model Cuenta {
  id                  String               @id @default(uuid()) @db.Uuid
  correo              String               @unique
  contrasenaHash      String
  rol                 Rol
  correoConfirmadoEn  DateTime?
  /// Autorización previa y expresa de tratamiento de datos (Ley 1581).
  autorizacionDatosEn DateTime
  creadaEn            DateTime             @default(now())
  estudiante          Estudiante?
  empresa             Empresa?
  sesiones            Sesion[]
  enlaces             EnlaceConfirmacion[]
}

/// Perfil del estudiante (M3). Los campos de catálogo guardan el id de @praxis/contracts (M2).
model Estudiante {
  cuentaId            String            @id @db.Uuid
  nombreCompleto      String
  nivelFormacion      String?
  /// Texto libre escrito por el estudiante (constitución v4.0.0, II): no es catálogo ni se compara.
  programa            String?           @db.VarChar(150)
  institucion         String?
  avance              String?
  disponibleDesde     DateTime?         @db.Date
  jornada             String?
  /// null = sin responder.
  aval                Boolean?
  perfilActualizadoEn DateTime?
  cuenta              Cuenta            @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  idiomas             IdiomaDeclarado[]
  archivos            ArchivoPerfil[]

  @@index([nivelFormacion])
}

model IdiomaDeclarado {
  cuentaId   String     @db.Uuid
  idioma     String
  nivel      String
  estudiante Estudiante @relation(fields: [cuentaId], references: [cuentaId], onDelete: Cascade)

  @@id([cuentaId, idioma])
  @@index([idioma])
}

enum TipoArchivo {
  HOJA_DE_VIDA
  SOPORTE_AVAL
  FOTO
}

/// Un archivo vigente por tipo. La clave es aleatoria; el nombre original solo se muestra.
model ArchivoPerfil {
  id         String      @id @default(uuid()) @db.Uuid
  cuentaId   String      @db.Uuid
  tipo       TipoArchivo
  clave      String      @unique
  nombre     String
  bytes      Int
  subidoEn   DateTime    @default(now())
  estudiante Estudiante  @relation(fields: [cuentaId], references: [cuentaId], onDelete: Cascade)

  @@unique([cuentaId, tipo])
}

model Empresa {
  cuentaId    String @id @db.Uuid
  razonSocial String
  /// Sin dígito de verificación; una sola cuenta por NIT.
  nit         String @unique
  dv          Int
  sector      String?
  ciudad      String?
  sitioWeb    String?
  descripcion String?
  correoContacto String?
  telefono    String?
  cuenta      Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
}

/// El id es el hash SHA-256 del token de la cookie; el token nunca se guarda.
model Sesion {
  id       String   @id
  cuentaId String   @db.Uuid
  expiraEn DateTime
  creadaEn DateTime @default(now())
  cuenta   Cuenta   @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([cuentaId])
}

/// Enlace de confirmación de un solo uso. El id es el hash SHA-256 del token del correo.
model EnlaceConfirmacion {
  id       String    @id
  cuentaId String    @db.Uuid
  expiraEn DateTime
  usadoEn  DateTime?
  creadoEn DateTime  @default(now())
  cuenta   Cuenta    @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([cuentaId])
}
