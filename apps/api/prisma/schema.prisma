generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ESTUDIANTE
  EMPRESA
}

/// Credenciales y estado de la cuenta. Los datos de cada rol viven aparte (anonimizar sin rehacer el modelo).
model Cuenta {
  id                  String               @id @default(uuid()) @db.Uuid
  correo              String               @unique
  contrasenaHash      String
  rol                 Rol
  correoConfirmadoEn  DateTime?
  /// Autorización previa y expresa de tratamiento de datos (Ley 1581).
  autorizacionDatosEn DateTime
  creadaEn            DateTime             @default(now())
  estudiante          Estudiante?
  empresa             Empresa?
  sesiones            Sesion[]
  enlaces             EnlaceConfirmacion[]
  notificaciones      Notificacion[]
}

/// Perfil del estudiante (M3). Los campos de catálogo guardan el id de @praxis/contracts (M2).
model Estudiante {
  cuentaId            String            @id @db.Uuid
  nombreCompleto      String
  nivelFormacion      String?
  /// Texto libre escrito por el estudiante (constitución v4.0.0, II): no es catálogo ni se compara.
  programa            String?           @db.VarChar(150)
  institucion         String?
  avance              String?
  disponibleDesde     DateTime?         @db.Date
  jornada             String?
  /// null = sin responder.
  aval                Boolean?
  perfilActualizadoEn DateTime?
  cuenta              Cuenta            @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  idiomas             IdiomaDeclarado[]
  archivos            ArchivoPerfil[]
  postulaciones       Postulacion[]

  @@index([nivelFormacion])
}

model IdiomaDeclarado {
  cuentaId   String     @db.Uuid
  idioma     String
  nivel      String
  estudiante Estudiante @relation(fields: [cuentaId], references: [cuentaId], onDelete: Cascade)

  @@id([cuentaId, idioma])
  @@index([idioma])
}

enum TipoArchivo {
  HOJA_DE_VIDA
  SOPORTE_AVAL
  FOTO
}

/// Un archivo vigente por tipo. La clave es aleatoria; el nombre original solo se muestra.
model ArchivoPerfil {
  id         String      @id @default(uuid()) @db.Uuid
  cuentaId   String      @db.Uuid
  tipo       TipoArchivo
  clave      String      @unique
  nombre     String
  bytes      Int
  subidoEn   DateTime    @default(now())
  estudiante Estudiante  @relation(fields: [cuentaId], references: [cuentaId], onDelete: Cascade)

  @@unique([cuentaId, tipo])
}

model Empresa {
  cuentaId    String @id @db.Uuid
  razonSocial String
  /// Sin dígito de verificación; una sola cuenta por NIT.
  nit         String @unique
  dv          Int
  sector      String?
  ciudad      String?
  sitioWeb    String?
  descripcion String?
  correoContacto String?
  telefono    String?
  vacantes    Vacante[]
  cuenta      Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
}

model Vacante {
  id String @id @default(uuid()) @db.Uuid
  empresaId String @db.Uuid
  empresa Empresa @relation(fields: [empresaId], references: [cuentaId], onDelete: Restrict)
  titulo String @db.VarChar(150)
  descripcion String
  modalidad String
  ciudad String?
  duracionMeses Int
  fechaInicio DateTime @db.Date
  vigencia DateTime @db.Date
  niveles String[]
  programas String[]
  avances Json
  aval Boolean
  jornada String
  idiomas Json
  estado String @default("Borrador")
  motivoCierre String?
  creadaEn DateTime @default(now())
  publicadaEn DateTime?
  cupoTipo String?
  cupoPeriodo DateTime?
  postulaciones Postulacion[]
  @@index([empresaId, estado])
  @@index([estado, vigencia])
  @@index([niveles], type: Gin)
  @@index([modalidad, ciudad])
}

model Postulacion {
  id String @id @default(uuid()) @db.Uuid
  vacanteId String @db.Uuid
  estudianteId String @db.Uuid
  vacante Vacante @relation(fields: [vacanteId], references: [id], onDelete: Restrict)
  estudiante Estudiante @relation(fields: [estudianteId], references: [cuentaId], onDelete: Restrict)
  estado String @default("Enviada")
  perfil Json
  evaluacion Json
  creadaEn DateTime @default(now())
  archivos ArchivoPostulacion[]
  historial HistorialPostulacion[]
  @@unique([vacanteId, estudianteId])
  @@index([estudianteId, creadaEn])
}

model ArchivoPostulacion {
  id String @id @default(uuid()) @db.Uuid
  postulacionId String @db.Uuid
  postulacion Postulacion @relation(fields: [postulacionId], references: [id], onDelete: Restrict)
  tipo String
  clave String @unique
  nombre String
  bytes Int
  @@unique([postulacionId, tipo])
}

model HistorialPostulacion {
  id String @id @default(uuid()) @db.Uuid
  postulacionId String @db.Uuid
  postulacion Postulacion @relation(fields: [postulacionId], references: [id], onDelete: Restrict)
  estado String
  fecha DateTime @default(now())
  @@index([postulacionId, fecha])
}

model Notificacion {
  id String @id @default(uuid()) @db.Uuid
  cuentaId String @db.Uuid
  cuenta Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  postulacionId String @db.Uuid
  texto String
  creadaEn DateTime @default(now())
  leidaEn DateTime?
  @@index([cuentaId, creadaEn])
}

/// El id es el hash SHA-256 del token de la cookie; el token nunca se guarda.
model Sesion {
  id       String   @id
  cuentaId String   @db.Uuid
  expiraEn DateTime
  creadaEn DateTime @default(now())
  cuenta   Cuenta   @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([cuentaId])
}

/// Enlace de confirmación de un solo uso. El id es el hash SHA-256 del token del correo.
model EnlaceConfirmacion {
  id       String    @id
  cuentaId String    @db.Uuid
  expiraEn DateTime
  usadoEn  DateTime?
  creadoEn DateTime  @default(now())
  cuenta   Cuenta    @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([cuentaId])
}
