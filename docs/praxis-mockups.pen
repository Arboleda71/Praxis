              "id": "qtlfY",
              "name": "Línea",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• warning.main = #B45309 para el chip «Falta información» con texto blanco (AA).",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "E9vCM",
              "name": "Línea",
              "fill": "$text",
